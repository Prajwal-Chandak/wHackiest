{
  "manifest_version": 3,
  "name": "ScholarSaathi — AI Scholarship Assistant",
  "version": "1.0.0",
  "description": "AI-powered Chrome side panel that explains complex scholarship forms, translates fields into Kannada & Hindi, checks documents, and smart-fills applications.",
  "action": {
    "default_title": "Open ScholarSaathi Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
